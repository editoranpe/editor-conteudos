{
  "name": "editor-conteudos",
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "editor-conteudos-npe",
      "database_id": "4fd5b99d-1477-44b4-b831-8c0317e67590",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "editor-conteudos-npe-arquivos" },
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
  },
}
